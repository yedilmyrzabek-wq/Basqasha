{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://basqasha.local/schemas/words.schema.json",
  "title": "Step 5 output: word timings (words.json)",
  "description": "Tokens of the TTS text that was actually voiced, with times in seconds from the start of the normalized voice file. Word index i is what storyboard *_word fields refer to. Produced by IAligner (PauseAligner now: silencedetect + proportional distribution, no ASR).",
  "type": "object",
  "required": ["language", "duration", "aligner", "words", "sentences", "quality"],
  "additionalProperties": false,
  "properties": {
    "language": {"enum": ["kk", "ru", "en"]},
    "duration": {"type": "number", "exclusiveMinimum": 0, "description": "Audio duration, s."},
    "aligner": {"enum": ["pause", "elevenlabs_timestamps"]},
    "words": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["i", "w", "start", "end", "s"],
        "additionalProperties": false,
        "properties": {
          "i": {"type": "integer", "minimum": 0},
          "w": {"type": "string", "minLength": 1, "description": "Word as spoken, punctuation kept attached."},
          "start": {"type": "number", "minimum": 0},
          "end": {"type": "number", "minimum": 0},
          "s": {"type": "integer", "minimum": 0, "description": "Sentence index."}
        }
      }
    },
    "sentences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["i", "start_word", "end_word", "start", "end", "anchored"],
        "additionalProperties": false,
        "properties": {
          "i": {"type": "integer", "minimum": 0},
          "start_word": {"type": "integer", "minimum": 0},
          "end_word": {"type": "integer", "minimum": 0, "description": "Inclusive."},
          "start": {"type": "number", "minimum": 0},
          "end": {"type": "number", "minimum": 0},
          "anchored": {"type": "boolean", "description": "Sentence end landed on a detected pause."}
        }
      }
    },
    "pauses": {
      "type": "array",
      "items": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "minItems": 2, "maxItems": 2},
      "description": "Detected silences [start, end], s."
    },
    "quality": {
      "type": "object",
      "required": ["anchored_ratio", "ok"],
      "additionalProperties": false,
      "properties": {
        "anchored_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "ok": {"type": "boolean", "description": "anchored_ratio >= 0.9; otherwise the operator reviews."},
        "wpm_measured": {"type": "number"},
        "warnings": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
