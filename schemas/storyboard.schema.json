{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://basqasha.local/schemas/storyboard.schema.json",
  "title": "Step 6 output: storyboard (AI <-> engine contract, brief §6.5)",
  "description": "All timing is in word indices of words.json (start_word/end_word inclusive). Coordinates are in the 1920x1080 frame. Rules not expressible here are enforced by the backend validator (see docs/ARCHITECTURE.md §6): scenes contiguous over all words, 2.5-7.5 s per scene, each background used 1-4 times (2-4 when backgrounds <= scenes/2), >= 2 visual events per scene, captions 2-7 words.",
  "type": "object",
  "required": ["language", "fps", "backgrounds", "scenes"],
  "additionalProperties": false,
  "properties": {
    "language": {"enum": ["kk", "ru", "en"]},
    "fps": {"const": 30},
    "backgrounds": {
      "type": "array",
      "minItems": 4,
      "maxItems": 62,
      "items": {
        "type": "object",
        "required": ["id", "prompt"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^bg[0-9]{2}$"},
          "prompt": {"type": "string", "minLength": 10, "description": "English scene description; STYLE SUFFIX is appended by the image step. No people, no text."},
          "file": {"type": "string", "description": "Relative to the project dir, e.g. images/bg01.png. Filled after step 7."}
        }
      }
    },
    "scenes": {"type": "array", "minItems": 30, "maxItems": 60, "items": {"$ref": "#/$defs/scene"}}
  },
  "$defs": {
    "word": {"type": "integer", "minimum": 0},
    "pose": {"type": "string", "pattern": "^[a-z0-9_]{2,32}$", "description": "Name from library/poses/poses.json."},
    "scene": {
      "type": "object",
      "required": ["id", "text", "start_word", "end_word", "background", "camera", "caption_keyword"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "text": {"type": "string"},
        "start_word": {"$ref": "#/$defs/word"},
        "end_word": {"$ref": "#/$defs/word"},
        "background": {"type": "string", "pattern": "^bg[0-9]{2}$"},
        "camera": {
          "type": "object",
          "required": ["zoom_from", "zoom_to", "focus"],
          "additionalProperties": false,
          "properties": {
            "zoom_from": {"type": "number", "minimum": 1.0, "maximum": 1.3},
            "zoom_to": {"type": "number", "minimum": 1.0, "maximum": 1.3},
            "focus": {"type": "array", "prefixItems": [{"type": "number", "minimum": 0, "maximum": 1}, {"type": "number", "minimum": 0, "maximum": 1}], "minItems": 2, "maxItems": 2},
            "punch_at_word": {"oneOf": [{"$ref": "#/$defs/word"}, {"type": "null"}], "description": "At most one punch-in (+5%) per scene."}
          }
        },
        "character": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["pose", "x", "y"],
              "additionalProperties": false,
              "properties": {
                "pose": {"$ref": "#/$defs/pose"},
                "x": {"type": "number", "minimum": 0, "maximum": 1920, "description": "Center."},
                "y": {"type": "number", "minimum": 0, "maximum": 1080, "description": "Feet line."},
                "height": {"type": "number", "minimum": 200, "maximum": 700, "default": 470},
                "flip": {"type": "boolean", "default": false},
                "pose_changes": {
                  "type": "array",
                  "maxItems": 4,
                  "items": {
                    "type": "object",
                    "required": ["at_word", "pose"],
                    "additionalProperties": false,
                    "properties": {"at_word": {"$ref": "#/$defs/word"}, "pose": {"$ref": "#/$defs/pose"}}
                  }
                }
              }
            }
          ]
        },
        "overlays": {"type": "array", "maxItems": 6, "items": {"$ref": "#/$defs/overlay"}},
        "caption_keyword": {"type": "string", "minLength": 3, "description": "Stem (>= 3 letters) prefix-matching exactly one word of the (first) caption phrase."},
        "captions": {
          "type": "array",
          "description": "Optional split of the scene into caption phrases (2-7 words, <= 42 chars/line). If omitted the whole scene is one phrase with caption_keyword.",
          "items": {
            "type": "object",
            "required": ["start_word", "end_word", "keyword"],
            "additionalProperties": false,
            "properties": {
              "start_word": {"$ref": "#/$defs/word"},
              "end_word": {"$ref": "#/$defs/word"},
              "keyword": {"type": "string", "minLength": 3}
            }
          }
        },
        "sfx": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["file", "at_word"],
            "additionalProperties": false,
            "properties": {
              "file": {"type": "string", "pattern": "^[a-z0-9_]+$", "description": "Name in library/sfx without extension: whoosh, pop, coin, ding, kaching."},
              "at_word": {"$ref": "#/$defs/word"},
              "volume": {"type": "number", "minimum": 0, "maximum": 1}
            }
          }
        },
        "beat": {"type": "string"}
      }
    },
    "overlay": {
      "type": "object",
      "required": ["type", "at_word"],
      "properties": {
        "type": {"enum": ["label", "counter", "arrow", "coins", "stamp", "note"]},
        "at_word": {"$ref": "#/$defs/word"},
        "x": {"type": "number", "minimum": 0, "maximum": 1920},
        "y": {"type": "number", "minimum": 0, "maximum": 1080},
        "color": {"enum": ["ink", "red", "blue", "green", "yellow"]}
      },
      "allOf": [
        {
          "if": {"properties": {"type": {"enum": ["label", "stamp"]}}},
          "then": {"required": ["text", "x", "y"], "properties": {"text": {"type": "string", "minLength": 1, "maxLength": 24, "pattern": "^\\S+(\\s+\\S+){0,4}$"}}}
        },
        {
          "if": {"properties": {"type": {"const": "counter"}}},
          "then": {"required": ["value", "x", "y"], "properties": {"value": {"type": "number"}, "from": {"type": "number"}, "prefix": {"type": "string", "maxLength": 4}, "suffix": {"type": "string", "maxLength": 8}, "text": {"type": "string", "maxLength": 24}, "fact_id": {"type": "string"}}}
        },
        {
          "if": {"properties": {"type": {"const": "arrow"}}},
          "then": {"required": ["x", "y", "x2", "y2"], "properties": {"x2": {"type": "number"}, "y2": {"type": "number"}}}
        },
        {
          "if": {"properties": {"type": {"const": "coins"}}},
          "then": {"required": ["x", "y", "x2", "y2"], "properties": {"x2": {"type": "number"}, "y2": {"type": "number"}, "count": {"type": "integer", "minimum": 1, "maximum": 12}}}
        },
        {
          "if": {"properties": {"type": {"const": "note"}}},
          "then": {"required": ["text"], "properties": {"text": {"type": "string", "maxLength": 80, "description": "Small grey source note, e.g. 'Дерек: stat.gov.kz'."}}}
        }
      ]
    }
  }
}
