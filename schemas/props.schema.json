{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://basqasha.local/schemas/props.schema.json",
  "title": "Remotion input props (Explainer / ExplainerShort)",
  "description": "Built by the backend from storyboard + words.json + poses.json. ALL timing in frames. Scene `from`/`duration` and captions/sfx are absolute frames; everything inside a scene (`at`, `punch`, pose schedule) is relative to the scene start (Remotion <Sequence> local time). Asset `src` values are absolute http URLs served by the backend (/files/...); relative values are resolved with staticFile() (engine fixtures only).",
  "type": "object",
  "required": ["composition", "width", "height", "fps", "duration_frames", "language", "voice", "scenes", "captions", "sfx"],
  "additionalProperties": false,
  "properties": {
    "composition": {"enum": ["Explainer", "ExplainerShort"]},
    "width": {"enum": [1920, 1080]},
    "height": {"enum": [1080, 1920]},
    "fps": {"const": 30},
    "duration_frames": {"type": "integer", "minimum": 1, "description": "= ceil(voice duration * fps)."},
    "language": {"enum": ["kk", "ru", "en"]},
    "voice": {"$ref": "#/$defs/audio"},
    "music": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/audio"}]},
    "progress_bar": {"type": "boolean", "default": true},
    "sponsor_badge": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "required": ["text", "from", "duration"], "additionalProperties": false,
         "properties": {"text": {"type": "string"}, "from": {"$ref": "#/$defs/frame"}, "duration": {"$ref": "#/$defs/frame"}}}
      ]
    },
    "scenes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/scene"}},
    "captions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "text", "keyword"],
        "additionalProperties": false,
        "properties": {
          "from": {"$ref": "#/$defs/frame"},
          "to": {"$ref": "#/$defs/frame"},
          "text": {"type": "string"},
          "keyword": {"type": "string", "description": "Highlight the first word that starts with this stem (case-insensitive)."}
        }
      }
    },
    "sfx": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["src", "from", "volume"],
        "additionalProperties": false,
        "properties": {"src": {"type": "string"}, "from": {"$ref": "#/$defs/frame"}, "volume": {"type": "number", "minimum": 0, "maximum": 1}}
      }
    }
  },
  "$defs": {
    "frame": {"type": "integer", "minimum": 0},
    "audio": {
      "type": "object",
      "required": ["src", "volume"],
      "additionalProperties": false,
      "properties": {
        "src": {"type": "string"},
        "volume": {"type": "number", "minimum": 0, "maximum": 1},
        "start_from": {"type": "integer", "minimum": 0, "description": "Frames to skip in the file (Shorts cut from the long voice)."}
      }
    },
    "scene": {
      "type": "object",
      "required": ["id", "from", "duration", "background"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "integer"},
        "from": {"$ref": "#/$defs/frame"},
        "duration": {"type": "integer", "minimum": 1},
        "background": {
          "type": "object",
          "required": ["src", "zoom_from", "zoom_to", "focus"],
          "additionalProperties": false,
          "properties": {
            "src": {"type": "string"},
            "zoom_from": {"type": "number"},
            "zoom_to": {"type": "number"},
            "focus": {"type": "array", "items": {"type": "number", "minimum": 0, "maximum": 1}, "minItems": 2, "maxItems": 2},
            "punch": {"type": "array", "items": {"$ref": "#/$defs/frame"}, "maxItems": 1}
          }
        },
        "character": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["x", "y", "height", "flip", "schedule"],
              "additionalProperties": false,
              "properties": {
                "x": {"type": "number"},
                "y": {"type": "number"},
                "height": {"type": "number"},
                "flip": {"type": "boolean"},
                "schedule": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["at", "pose", "src", "width", "height"],
                    "additionalProperties": false,
                    "properties": {
                      "at": {"$ref": "#/$defs/frame"},
                      "pose": {"type": "string"},
                      "src": {"type": "string"},
                      "width": {"type": "integer", "description": "Native PNG size, from poses.json."},
                      "scale": {"type": "number", "minimum": 0.2, "maximum": 2, "description": "Figure height relative to a standing pose (poses.json); default 1."},
                      "height": {"type": "integer"}
                    }
                  }
                }
              }
            }
          ]
        },
        "overlays": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "at"],
            "description": "Same fields as storyboard overlays, with at_word replaced by `at` (scene-relative frame).",
            "properties": {
              "type": {"enum": ["label", "counter", "arrow", "coins", "stamp", "note"]},
              "at": {"$ref": "#/$defs/frame"}
            }
          }
        }
      }
    }
  }
}
