# Copy to .env and fill in. Secrets live ONLY in .env (never in DB or git).

# --- Database: Supabase Session pooler (port 5432, NOT 6543; password URL-encoded)
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# --- AI
GEMINI_API_KEY=
MODEL_TEXT=gemini-3.8-flash
MODEL_SCRIPT=gemini-4-argon
MODEL_SCRIPT_FALLBACK=gemini-3.8-flash
MODEL_CHEAP=gemini-3.5-flash-lite
MODEL_IMAGE=gemini-nano-banana-2.1
MODEL_IMAGE_FALLBACK=gemini-3.1-flash-image
MODEL_POSE_SHEET=gemini-3-pro-image
MODEL_EMBED=gemini-embedding-2
SCRIPT_WRITER=gemini            # gemini | claude_code
CLAUDE_CLI=claude

# --- Future providers (disabled)
ELEVENLABS_API_ENABLED=false
ELEVENLABS_API_KEY=
YOUTUBE_API_ENABLED=false

# --- Paths (relative to repo root or absolute)
DATA_DIR=./data
LIBRARY_DIR=./library
ENGINE_DIR=./engine

# --- Servers
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ASSET_BASE_URL=http://127.0.0.1:8000   # used in props.json asset URLs for Remotion
FRONTEND_PORT=5173

# --- Budgets (USD; seed values for settings, editable in UI)
BUDGET_PROJECT_USD=5.00
BUDGET_PROJECT_WARN_USD=2.50
BUDGET_MONTH_STOP_USD=60

# --- Defaults
DEFAULT_LANGUAGE=kk
DEFAULT_TARGET_SECONDS=240
DEFAULT_WPM_VOICE=110

# --- Tools (names on PATH or absolute paths)
NODE_BIN=node
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
PG_DUMP_BIN=pg_dump
LOG_LEVEL=INFO

# Text steps: claude_code (Claude subscription via `claude -p`) | gemini
TEXT_LLM=claude_code
CLAUDE_MODEL=sonnet
CLAUDE_MODEL_SCRIPT=opus
